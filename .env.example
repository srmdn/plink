# Optional listener address; blank uses :8080 (all interfaces)
ADDR=

# Optional SQLite database path; blank uses plink.db
DB_PATH=

# Admin password — required, no default; use at least 12 characters
ADMIN_PASSWORD=

# Environment: set to "production" to enable Secure cookie flag (requires HTTPS)
APP_ENV=development

# Reporting timezone for daily analytics; use an IANA name such as Asia/Jakarta
APP_TIMEZONE=UTC

# Optional admin path; blank uses "admin" (login at /admin/login)
ADMIN_PATH=

# Optional canonical public origin used for copied links, canonical URLs,
# sitemap, and OG images; blank uses the request origin
PUBLIC_URL=

# Site branding shown on the public homepage
SITE_NAME=plink
SITE_DESC=personal links

# Optional directory for uploaded images; blank uses <database dir>/uploads
UPLOADS_DIR=

# Optional analytics script for public pages; blank disables it (recommended).
# Example (Umami): https://analytics.example.com/script.js
ANALYTICS_SCRIPT_URL=

# Optional website ID attribute for the analytics script (e.g. Umami data-website-id)
ANALYTICS_WEBSITE_ID=

# Allow Cloudflare Web Analytics (injected by the Cloudflare proxy) in the CSP.
# Set to 1 only when the site is served behind Cloudflare with Web Analytics on.
CLOUDFLARE_INSIGHTS=
