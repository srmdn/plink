# Optional local bind address; leave blank to use the app default
ADDR=

# Optional local SQLite database path; leave blank to use the app default
DB_PATH=

# Admin password — required, no default
ADMIN_PASSWORD=

# Environment: set to "production" to enable Secure cookie flag (requires HTTPS)
APP_ENV=development

# Reporting timezone for daily analytics; use an IANA name such as Asia/Jakarta
APP_TIMEZONE=UTC

# Optional admin path; leave blank to use the app default
ADMIN_PATH=

# Optional canonical public URL used for copy, share, and QR links
PUBLIC_URL=

# Site branding shown on the public homepage
SITE_NAME=plink
SITE_DESC=personal links

# Optional analytics script for public pages; blank disables it (recommended).
# Example (Umami): https://analytics.example.com/script.js
ANALYTICS_SCRIPT_URL=

# Optional website ID attribute for the analytics script (e.g. Umami data-website-id)
ANALYTICS_WEBSITE_ID=
